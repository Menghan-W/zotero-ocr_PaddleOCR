{
  "manifest_version": 2,
  "name": "Zotero OCR (PaddleOCR)",
  "version": "1.0.0",
  "description": "Zotero Plugin for OCR using PaddleOCR",
  "author": "Menghan-W (based on original by Philipp Zumstein)",
  "homepage_url": "https://github.com/Menghan-W/zotero-ocr_PaddleOCR",
  "icons": {
    "48": "chrome/skin/default/zoteroocr/ocr-symbol.svg",
    "96": "chrome/skin/default/zoteroocr/ocr-symbol.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-ocr-paddleocr@menghan-w.github.io",
      "update_url": "https://raw.githubusercontent.com/Menghan-W/zotero-ocr_PaddleOCR/main/updates.json",
      "strict_min_version": "6.999",
      "strict_max_version": "8.*"
    }
  }
}
